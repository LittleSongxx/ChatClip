# 高级部署参数参考：仅复制需要覆盖的项到 .env；不需要全部填写。
# TalkNet 路径留空时自动寻找 data/models/talknet 下的安装文件。

# ===== 推荐模型主线（2026-09 定版）=====
# 角色          主推荐                         降级候选
# 视觉 VISION   qwen3-vl-max @ 阿里云百炼       doubao-seed-2.0 @ 火山方舟
# 剪辑规划 LLM  deepseek-flash @ DeepSeek       qwen3.8-max @ 阿里云百炼
# Agent 执行    qwen3.8-max @ 阿里云百炼        glm-4.6 @ 智谱 BigModel
# 主线只需两个账号：阿里云百炼（DashScope）+ DeepSeek 开放平台。
# provider 取值：bailian / deepseek / bigmodel / ark / openai / openai_compatible。

# 视觉分析模型（多模态，OpenAI Chat Completions 兼容）
VISION_PROVIDER=bailian
VISION_API_KEY=
VISION_MODEL=qwen3-vl-max
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼开关 Qwen 混合推理；方舟/智谱使用 disabled、enabled 或 auto
VISION_THINKING_TYPE=disabled
# 支持 json_object 的接口保持默认；不支持时改为 none
VISION_RESPONSE_FORMAT=json_object
VISION_TIMEOUT_SECONDS=90

# 剪辑规划 LLM（结构化 JSON 规划，deepseek-flash 即 DeepSeek-V4.1-Flash）
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_THINKING_TYPE=
LLM_TIMEOUT_SECONDS=60

# Agent 执行模型（必须支持 Tool Calling）
AGENT_API_KEY=
AGENT_MODEL=qwen3.8-max
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_THINKING_TYPE=enabled
AGENT_TIMEOUT_SECONDS=120

# 可选：Anthropic 协议（三项同时填写时启用）
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# ===== 服务与安全 =====
CHATCLIP_INSTALL_PROFILE=cpu
# 本机安全默认值；容器或远程部署可改为 0.0.0.0，并应同时配置访问令牌
CHATCLIP_HOST=127.0.0.1
CHATCLIP_PORT=5180
# Docker Compose 发布地址；远程访问必须同时配置访问令牌
CHATCLIP_BIND_ADDRESS=127.0.0.1
CHATCLIP_DATA_ROOT=./data
CHATCLIP_MAX_WORKERS=1
CHATCLIP_MAX_UPLOAD_BYTES=8589934592
# 全部任务数据的磁盘上限（默认 50 GiB）
CHATCLIP_MAX_STORAGE_BYTES=53687091200
# 0 表示不自动清理；正整数表示清理超过该天数且未置顶的任务
CHATCLIP_RETENTION_DAYS=0
CHATCLIP_ACCESS_TOKEN=
# 仅限可信内网；开启后外部监听不再要求访问令牌
CHATCLIP_ALLOW_UNAUTHENTICATED_REMOTE=false
# 允许填写内网/私有模型接口地址（默认拒绝，防 SSRF）
CHATCLIP_ALLOW_PRIVATE_MODEL_ENDPOINTS=false
CHATCLIP_LOG_LEVEL=INFO
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
CHATCLIP_SUBTITLE_FONT=

# ===== 语音识别（本地）=====
CHATCLIP_SPEECH_ENGINE=sensevoice
CHATCLIP_SENSEVOICE_MODEL=iic/SenseVoiceSmall
CHATCLIP_SENSEVOICE_DEVICE=auto
CHATCLIP_SENSEVOICE_VAD_MODEL=fsmn-vad
# 留空禁用外置标点模型（CT-Punc 约 1.1 GiB）
CHATCLIP_SENSEVOICE_PUNC_MODEL=
CHATCLIP_SENSEVOICE_SPK_MODEL=cam++
# 说话人分离默认关闭；按需开启
CHATCLIP_SENSEVOICE_DIARIZATION=false
CHATCLIP_SPEECH_MODEL_CACHE=./data/models
# 降级 ASR 引擎（可选）
CHATCLIP_WHISPER_MODEL=
CHATCLIP_WHISPER_DEVICE=auto

# ===== 声纹库 =====
# 32 字节 Base64；填写后才能登记声纹
CHATCLIP_VOICEPRINT_ENCRYPTION_KEY=
CHATCLIP_VOICEPRINT_MODEL=iic/speech_campplus_sv_zh-cn_16k-common
CHATCLIP_VOICEPRINT_DEVICE=cpu
CHATCLIP_VOICEPRINT_REVIEW_THRESHOLD=0.31
CHATCLIP_VOICEPRINT_ACCEPT_THRESHOLD=0.38
CHATCLIP_VOICEPRINT_MARGIN_THRESHOLD=0.05

# ===== 多模态识别索引 =====
CHATCLIP_RECOGNITION=true
CHATCLIP_RECOGNITION_PROFILE=auto
CHATCLIP_RECOGNITION_MODEL_CACHE=./data/models/recognition
CHATCLIP_RECOGNITION_PYTHON=
CHATCLIP_VISUAL_EMBEDDING_BACKEND=siglip
CHATCLIP_SIGLIP_MODEL=google/siglip2-base-patch16-224
CHATCLIP_TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHATCLIP_CLAP_MODEL=laion/clap-htsat-fused
CHATCLIP_GROUNDING_MODEL=IDEA-Research/grounding-dino-tiny
CHATCLIP_YUNET_MODEL=
CHATCLIP_SFACE_MODEL=
CHATCLIP_YOLOX_MODEL=
CHATCLIP_YOUTUREID_MODEL=
CHATCLIP_OCR_ENABLED=true
# WeMM 视觉后端（可选，独立 venv）
CHATCLIP_WEMM_MODEL=tencent/WeMM-Embedding-2B
CHATCLIP_WEMM_DIMENSION=256
CHATCLIP_WEMM_VIDEO_INDEX=true
CHATCLIP_WEMM_RECALL_THRESHOLD=0.18
CHATCLIP_WEMM_EXHAUSTIVE_VLM_FALLBACK=false

# ===== 内容检索 =====
CONTENT_SEARCH_DIALOGUE_V2=true
CONTENT_SEARCH_MODEL_CONCURRENCY=3

# ===== 人物说话识别（TalkNet，可选）=====
CHATCLIP_ACTIVE_SPEAKER_MODE=primary
CHATCLIP_TALKNET_PYTHON=
CHATCLIP_TALKNET_WORKER=
CHATCLIP_TALKNET_REPOSITORY=
CHATCLIP_TALKNET_CHECKPOINT=
CHATCLIP_TALKNET_DEVICE=auto
CHATCLIP_TALKNET_TIMEOUT_SECONDS=900
